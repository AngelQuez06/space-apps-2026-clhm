FLASK_DEBUG=1
PORT=5000
CORS_ORIGINS=*
# Zone: Mount Sharp (Aeolis Mons), Gale Crater.
ZONE_NAME=Mount Sharp (Aeolis Mons), Gale Crater
ZONE_CENTER_LAT=-5.4
ZONE_CENTER_LON=137.8
# Security (production values live in Cloud Run env vars, see DEPLOY.md)
# CORS_ORIGINS above is "*" for local dev only; the code default is the clhm.study domain.
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_TILES=1200 per minute
# "min_lon,min_lat,max_lon,max_lat"; when set, tiles outside it return 404
ZONE_BBOX=
# Tiles: extra zoom levels served by upscaling, upstream timeout (s)
MAX_OVERZOOM=3
UPSTREAM_TIMEOUT=20
